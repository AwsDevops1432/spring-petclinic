node {

    stage ('clone'){

      git branch: 'feature/2026.07.14', url: 'https://github.com/AwsDevops1432/spring-petclinic.git'
    }

   stage ('build'){

      bat 'mvn clean install'
}
stage ('test'){

      bat 'mvn test'
}
stage ('generated reports'){

      junit stdioRetention: 'ALL', testResults: 'target/surefire-reports/*.xml'
}
stage ('generated artifacts'){

      barchiveArtifacts artifacts: 'target/.jar'
}
stage ('deploy'){

      echo 'deploy'
}

